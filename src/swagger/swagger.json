{
  "swagger": "2.0",
  "info": {
    "title": "BookVerse API",
    "description": "API documentation for the BookVerse application.",
    "version": "1.0.0"
  },
  "host": "localhost:5000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "paths": {
    "/health": {
      "get": {
        "description": "Check backend server and database connection health.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/books/": {
      "get": {
        "description": "Retrieve all books from the catalog.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "description": "Add a new book to the database.",
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/books/{id}": {
      "get": {
        "description": "Get a specific book by ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "put": {
        "description": "Update a book's details by ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "description": "Delete a book from the system by ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/orders/": {
      "get": {
        "description": "Retrieve all orders with populated user and book data.",
        "responses": {
          "200": {
            "description": "Orders fetched successfully."
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "description": "Place a brand new book order with subdocuments and nested shipping location.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/OrderInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Order placed successfully!"
          },
          "400": {
            "description": "Bad Request - Validation Failed"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/orders/{id}": {
      "delete": {
        "description": "Cancel and remove an order by ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Order cancelled successfully."
          },
          "404": {
            "description": "Order not found."
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "definitions": {
    "OrderItem": {
      "type": "object",
      "required": ["book", "quantity", "price"],
      "properties": {
        "book": {
          "type": "string",
          "example": "65f1a2b3c4d5e6f7a8b9c0d1",
          "description": "MongoDB ObjectId of the targeted book reference"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "example": 1
        },
        "price": {
          "type": "number",
          "example": 12500
        }
      }
    },
    "Address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string",
          "example": "Plot 14, Phase 2, Millennium Estate, Danjuma Drive"
        },
        "city": {
          "type": "string",
          "example": "Port Harcourt"
        },
        "state": {
          "type": "string",
          "example": "Rivers"
        },
        "country": {
          "type": "string",
          "example": "Nigeria"
        },
        "zipCode": {
          "type": "string",
          "example": "500102"
        }
      }
    },
    "OrderInput": {
      "type": "object",
      "required": ["user", "items", "totalAmount", "shippingAddress"],
      "properties": {
        "user": {
          "type": "string",
          "example": "65f1a2b3c4d5e6f7a8b9c0d9",
          "description": "MongoDB ObjectId of the purchasing User"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OrderItem"
          }
        },
        "totalAmount": {
          "type": "number",
          "example": 12500
        },
        "shippingAddress": {
          "$ref": "#/definitions/Address"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "processing", "shipped", "delivered", "cancelled"],
          "default": "pending",
          "example": "pending"
        }
      }
    }
  }
}